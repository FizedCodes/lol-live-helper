# Get a free development key at https://developer.riotgames.com (expires every 24h).
# Optional: leave this as the placeholder and paste a key in Setup instead —
# that key lives in server memory only for this run (gone when you stop uvicorn).
# Never commit a real key. Restart after changing .env (load_dotenv at process start).
RIOT_API_KEY=RGAPI-your-key-here

# Regional routing for Match-V5 / Account-V1: americas, europe, asia, sea
RIOT_REGION=americas

# Platform routing for League-V4 (ranks): na1, br1, la1, la2, euw1, eun1, tr1, ru, me1, kr, jp1, oc1, sg2, tw2, vn2
RIOT_PLATFORM=na1

# How many recent matches to sync for matchup stats
SYNC_MATCH_COUNT=200
